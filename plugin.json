{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "linkedcamp",
  "version": "1.0.0",
  "description": "Plan, build and run LinkedIn and email outreach campaigns in LinkedCamp from Hermes: audience searches, multi-step sequences, leads, inbox replies, sending-account health and campaign analytics.",
  "author": {
    "name": "LinkedCamp",
    "url": "https://www.linkedcamp.com"
  },
  "homepage": "https://www.linkedcamp.com/mcp",
  "repository": "https://github.com/LinkedCamp/hermes-plugin",
  "license": "MIT",
  "keywords": [
    "linkedin",
    "outreach",
    "sales",
    "email",
    "campaigns",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "linkedcamp": {
          "trust": "untrusted"
        }
      }
    }
  }
}
